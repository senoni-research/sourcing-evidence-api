APP_ENV=development
SERVICE_API_KEY=
EXTRACTOR_MODE=template
MODEL_TIMEOUT_SECONDS=15
# Local-only durable workflow testing. Hosted demo uses Firestore.
WORKFLOW_BACKEND=memory
WORKFLOW_FILE=.demo-data/workflows.json
FIRESTORE_DATABASE=sourcing-demo
# Public hosted mode: APP_ENV=production, PUBLIC_DEMO=true, WORKFLOW_BACKEND=firestore.
# No browser API key, arbitrary uploads or live model extraction in that mode.
PUBLIC_DEMO=false
# Developer machine only: lets PUBLIC_DEMO use WORKFLOW_BACKEND=local_test_store over plain HTTP,
# to check the hosted UI in a browser. Never set this on a deployed service.
LOCAL_INSECURE_DEMO=false
# Optional approved OpenAI-compatible gateway; never put credentials in git.
# MODEL_BASE_URL=https://approved-gateway.example/v1
# MODEL_NAME=your-approved-model
# MODEL_API_KEY=
